# .editorconfig — Consistent coding style across editors
# GitHub shows this as plain text; editors read it automatically
# https://editorconfig.org

root = true

# ── All files ─────────────────────────────────────────────────────────────────
[*]
charset                  = utf-8
end_of_line              = lf
indent_style             = space
indent_size              = 2
trim_trailing_whitespace = true
insert_final_newline     = true

# ── Python ────────────────────────────────────────────────────────────────────
[*.py]
indent_size = 4
max_line_length = 88

# ── Markdown ──────────────────────────────────────────────────────────────────
[*.md]
trim_trailing_whitespace = false   # Trailing spaces = line break in Markdown
max_line_length          = off

# ── YAML ──────────────────────────────────────────────────────────────────────
[*.{yml,yaml}]
indent_size = 2

# ── JSON ──────────────────────────────────────────────────────────────────────
[*.json]
indent_size = 2

# ── Makefiles ─────────────────────────────────────────────────────────────────
[Makefile]
indent_style = tab   # Makefiles require tabs

# ── Shell scripts ─────────────────────────────────────────────────────────────
[*.sh]
indent_size = 2
